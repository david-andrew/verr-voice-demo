{
  "version": 1,
  "words": {
    "lead": {
      "default": "guide",
      "choices": {
        "guide": {
          "label": "guide · leed",
          "phones": "L IY D"
        },
        "metal": {
          "label": "metal · led",
          "phones": "L EH D"
        }
      },
      "rules": [
        [
          "metal",
          "\\b(?:of|molten|heavy|heavy as|made of|cast in|white|red) lead\\b|\\blead (?:weight|pipe|pipes|poison|bullet|shot|pencil|coffin)\\b"
        ],
        [
          "guide",
          "\\blead (?:me|us|them|him|her|you|the way|on|kindly|to|into|through|by)\\b|\\b(?:shall|will|would|can|may|must|to) lead\\b"
        ]
      ]
    },
    "read": {
      "default": "present",
      "choices": {
        "present": {
          "label": "present tense · reed",
          "phones": "R IY D"
        },
        "past": {
          "label": "past tense · red",
          "phones": "R EH D"
        }
      },
      "rules": [
        [
          "past",
          "\\b(?:have|has|had|having|already|once|yesterday) (?:\\w+ ){0,2}read\\b|\\bread (?:it |this |that )?(?:yesterday|last night|long ago)\\b"
        ],
        [
          "present",
          "\\b(?:to|will|shall|can|must|please) read\\b"
        ]
      ]
    },
    "live": {
      "default": "verb",
      "choices": {
        "verb": {
          "label": "to live · liv",
          "phones": "L IH V"
        },
        "adjective": {
          "label": "alive or live performance · lyve",
          "phones": "L AY V"
        }
      },
      "rules": [
        [
          "adjective",
          "\\blive (?:music|performance|broadcast|wire|wires|coal|coals|recording|show|concert|stream|animal|animals)\\b"
        ],
        [
          "verb",
          "\\b(?:i|we|they|you|to|shall|will|may|must|let.*) live\\b|\\blive (?:in|on|with|for|forever|again|and|alone|no more)\\b"
        ]
      ]
    },
